# Supabase — get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose to the client.
# Used by API routes to read/write data after PIN verification.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign session cookies (any long random string).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret
